# deploy/config/secrets.env — Secret values for cluster deployment
#
# Copy this file to secrets.env and fill in your values.
# secrets.env is gitignored — NEVER commit it.
# It is NOT allowlisted in gitleaks — the scanner will flag it if staged.
#
# Usage: ./deploy/setup/setup-secrets.sh --from-env deploy/config/secrets.env
#
# These values are written to K8s Secrets (the on-cluster source of truth).
# After running setup-secrets.sh, this file can be deleted from disk.

# OpenAI API key (used by MaaS gateway for LLM inference)
OPENAI_API_KEY=

# MinIO artifact store credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# FHIR server (Medplum) client credentials
FHIR_CLIENT_ID=
FHIR_CLIENT_SECRET=

# Medplum user credentials (for the data loader job — optional)
# Leave blank to skip creating this secret; the loader job won't run.
MEDPLUM_SUPERADMIN_PASSWORD=
MEDPLUM_ADMIN_EMAIL=
MEDPLUM_ADMIN_PASSWORD=
MEDPLUM_PRACTITIONER_PASSWORD=
