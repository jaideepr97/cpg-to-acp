# Medplum user credentials for load-medplum.sh
# Copy to .env and fill in, or export as environment variables.

# CareView EHR project admin
MEDPLUM_ADMIN_EMAIL=admin@careview.example
MEDPLUM_ADMIN_PASSWORD=CHANGE_ME

# Demo practitioner users (Dr. Mitchell, Dr. Park)
MEDPLUM_PRACTITIONER_PASSWORD=CHANGE_ME

# Medplum seeded super admin — change on first boot to secure the instance
MEDPLUM_SUPERADMIN_PASSWORD=CHANGE_ME
